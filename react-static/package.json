{
  "name": "markaz-static-react",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.jsx --outDir .ssr",
    "prerender": "node scripts/prerender.mjs",
    "build": "npm run build:client && npm run build:ssr && npm run prerender",
    "preview": "vite preview --host 0.0.0.0",
    "build:github-pages": "STATIC_SITE_URL=https://markazulafiniyyah-web.github.io VITE_BASE_PATH=/ npm run build"
  },
  "dependencies": {
    "@fontsource/amiri-quran": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "@vitejs/plugin-react": "latest",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-helmet-async": "^3.0.0",
    "typescript": "latest",
    "vite": "latest"
  }
}
